# dependencies
node_modules/
.pnpm-store/

# build output — electron-vite bundles into out/, electron-builder into dist*/release/
out/
dist/
dist-*/
release/
coverage/

# agent scratch
# .opencode/ holds OpenCode's auto-installed plugin deps; only workflows/ is source.
.opencode/package.json
.opencode/package-lock.json
.claude/
.claude-octopus/
.agents/

# typescript incremental / project-reference state
*.tsbuildinfo
.tsbuildinfo/

# secrets — never commit real provider keys.
# OpenCode stores credentials in its own auth store (see README), not here.
.env
.env.*
!.env.example
opencode.json
auth.json

# logs
*.log
npm-debug.log*
logs/

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# caches
.cache/
.vite/
.eslintcache
coverage-output.txt
